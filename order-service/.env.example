# order-service — copy sang `.env` khi chạy local. Trên K8s: ConfigMap + Secret.
HOST=0.0.0.0
PORT=8002
SERVICE_NAME=order-service
APP_VERSION=1.0.0
LOG_LEVEL=INFO

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=orders_user
MYSQL_PASSWORD=orders_password
MYSQL_DATABASE=shop_orders
DB_CONNECT_TIMEOUT=3
DB_PING_TIMEOUT=3

JWT_SECRET=dev-only-secret-change-me
JWT_ISSUER=shop
JWT_EXPIRE_SECONDS=86400

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- liên service (demonstrate Cluster DNS) ---
# Local:   http://127.0.0.1:8001
# K8s:     http://product-service:8001   (khác namespace: product-service.<ns>.svc.cluster.local:8001)
PRODUCT_SERVICE_BASE_URL=http://127.0.0.1:8001
PRODUCT_SERVICE_TIMEOUT=3
MAX_ITEMS_PER_ORDER=20
