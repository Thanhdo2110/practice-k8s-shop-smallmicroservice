# product-service — copy sang `.env` khi chạy local. Trên K8s: ConfigMap + Secret.
HOST=0.0.0.0
PORT=8001
SERVICE_NAME=product-service
APP_VERSION=1.0.0
LOG_LEVEL=INFO

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=catalog_user
MYSQL_PASSWORD=catalog_password
MYSQL_DATABASE=shop_catalog
DB_CONNECT_TIMEOUT=3
DB_PING_TIMEOUT=3

# JWT_SECRET phải TRÙNG với auth-service, nếu không /api/v1/products POST sẽ 401
JWT_SECRET=dev-only-secret-change-me
JWT_ISSUER=shop
JWT_EXPIRE_SECONDS=86400

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
