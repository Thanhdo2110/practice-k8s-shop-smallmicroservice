# auth-service — copy sang `.env` khi chạy local. Trên K8s đưa vào ConfigMap + Secret.
HOST=0.0.0.0
PORT=8000
SERVICE_NAME=auth-service
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# --- MySQL (MYSQL_PASSWORD + JWT_SECRET => Kubernetes Secret) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=auth_user
MYSQL_PASSWORD=auth_password
MYSQL_DATABASE=shop_auth
DB_CONNECT_TIMEOUT=3
DB_PING_TIMEOUT=3

# --- JWT: 3 service + frontend phải dùng CHUNG một giá trị ---
JWT_SECRET=dev-only-secret-change-me
JWT_ISSUER=shop
JWT_EXPIRE_SECONDS=86400

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
