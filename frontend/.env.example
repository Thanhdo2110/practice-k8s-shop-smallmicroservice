# Frontend — copy sang `.env.local` khi chạy local (Vite chỉ đọc file .env*).
#
# VITE_API_BASE_URL: để trống = gọi same-origin (/api/v1/...).
#   - Local : Vite dev proxy san sang 3 backend (xem vite.config.js)
#   - K8s   : Ingress path /api/v1/auth|products|categories|orders -> đúng service
# Chỉ đặt giá trị khác khi bạn expose mỗi service một host riêng.
VITE_API_BASE_URL=
VITE_APP_TITLE=Shop K8s

# --- biến chỉ dùng cho dev proxy, KHÔNG sang browser (không có tiền tố VITE_) ---
AUTH_API_URL=http://127.0.0.1:8000
PRODUCT_API_URL=http://127.0.0.1:8001
ORDER_API_URL=http://127.0.0.1:8002
DEV_PORT=5173
